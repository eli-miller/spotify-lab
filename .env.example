# Spotify Developer App credentials
# Create your app at https://developer.spotify.com/dashboard
# Set redirect URI to http://127.0.0.1:8888/callback in the app settings
# Note: localhost is no longer accepted by Spotify (policy change April 2025)
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Find this by opening open.spotify.com, navigating to Release Radar, and copying the ID from the URL
RELEASE_RADAR_PLAYLIST_ID=your_release_radar_playlist_id_here

# Gmail SMTP — use an App Password, not your account password
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
GMAIL_RECIPIENT=you@gmail.com
